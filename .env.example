# Secure Electronic Mail Gateway Environment Variables
# Copy to .env for local development

# Base URL for API requests. Leave blank for same-origin deployment (/api/...)
VITE_API_BASE_URL=

# Gateway Operator identity
GATEWAY_OPERATOR_NAME="Mansi Chalak"
GATEWAY_DOMAIN="gateway.internal"

# Academic demonstration switches
ENABLE_DEMO_CREDENTIALS="true"
NODE_ENV="production"
